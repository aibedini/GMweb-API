node_modules/
.env
data/
.vscode/
*.log
*.code-workspace

# Local backups. Installers and manual recovery leave these next to the
# checkout — often ROOT-owned, so the manager's pre-update
# "git stash --include-untracked" (which runs as the app user) failed with a
# bare "Permission denied" and the update never started.
.env.bak*
*.bak
*.bak-*
.codex-temp-gmweb-repair-key
.codex-temp-gmweb-repair-key.pub

# graphify regenerable cache (graph itself is committed)
graphify-out/cache/

# Vite SPA console deps (build output in public/dashboard-next is committed)
dashboard-next/node_modules/
dashboard-next/dist/
web/node_modules/

# Build caches and build provenance. These change on every build (timestamps,
# incremental state) but are NOT release artifacts, so committing them would
# make every deployment dirty the working tree and hide real drift.
*.tsbuildinfo
public/web-app/build-info.json
